{
  "expo": {
    "name": "Cantapp Operator",
    "slug": "cantapp-operator",
    "scheme": "cantappoperator",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que Operator use la cámara para escanear recursos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "android": {
      "package": "com.cantapp.operator",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e756884d-236b-4247-9f39-8cb452088093"
      }
    },
    "owner": "gebbdev"
  }
}
